---
import BaseHead from "@/components/BaseHead.astro";
import DesktopIcons from "@/components/DesktopIcons.astro";
import DesktopWidgets from "@/components/DesktopWidgets.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html class="scroll-smooth dark" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen w-full max-w-none flex-col px-4 pt-4 pb-16 font-mono text-sm font-normal antialiased sm:px-8 lg:px-12"
	>
		<ThemeProvider />
		{/* Inlined to avoid a flash of the full desktop chrome inside spawned iframe windows. */}
		<script is:inline>
			if (window.self !== window.top) document.documentElement.classList.add("embedded-page");
		</script>
		<SkipLink />

		<div class="window-workspace">
			<DesktopIcons />
			<DesktopWidgets />
			<main id="main" class="aero-window" hidden>
				<div class="aero-titlebar">
					<div class="aero-controls">
						<button class="aero-control aero-control-minimize" type="button" aria-label="Venster minimaliseren" data-window-minimize></button>
						<button class="aero-control aero-control-zoom" type="button" aria-label="Venster maximaliseren" data-window-maximize></button>
						<button class="aero-control aero-control-close" type="button" aria-label="Venster sluiten" data-window-close></button>
					</div>
					<span class="aero-window-title">daandobber.nl</span>
					<span class="aero-titlebar-shine" aria-hidden="true"></span>
				</div>
				<div class="aero-window-content">
					<slot />
				</div>
			</main>
		</div>
		<Footer />
	</body>
</html>
