---
import type { ImageMetadata } from "astro";
import bggCollectionData from "@/data/bgg_collection.json";
import dimensionData from "@/data/bgg_dimensions.json";
import spineData from "@/data/bgg_spines.json";
import PageLayout from "@/layouts/Base.astro";
import type { BoardGame, SiteMeta } from "@/types";

const games = ((bggCollectionData?.games ?? []) as BoardGame[])
	.filter((game) => game.status?.own !== false && !game.is_expansion)
	.sort((a, b) => a.name.localeCompare(b.name, "nl", { sensitivity: "base" }));

// Covers staan als <bgg-id>.jpg/.png in src/assets/bordspellen; ontbreekt er een, dan valt de pagina terug op de BGG-thumbnail.
// De covers zijn al klein (±400 px), dus ze gaan ongewijzigd mee; zo is sharp niet nodig.
const coverFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/bordspellen/*.{jpg,jpeg,png,webp}", { eager: true });
const covers = new Map(
	Object.entries(coverFiles).map(([path, file]) => [path.split("/").pop()?.replace(/\.\w+$/, "") ?? "", file.default])
);
// Logo-uitsneden en rugkleuren voor de zijkanten komen uit scripts/make_spines.py.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/bordspellen/logos/*.webp", { eager: true });
const logos = new Map(
	Object.entries(logoFiles).map(([path, file]) => [path.split("/").pop()?.replace(/\.\w+$/, "") ?? "", file.default])
);
const spineColors = spineData as Record<string, { color?: string }>;
// Eigen foto's van zijkanten (rechtop, als <bgg-id>.jpg in src/assets/bordspellen/zijkanten) gaan voor op de gegenereerde zijkant.
const spineFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/bordspellen/zijkanten/*.{jpg,jpeg,png,webp}", { eager: true });
const spines = new Map(
	Object.entries(spineFiles).map(([path, file]) => [path.split("/").pop()?.replace(/\.\w+$/, "") ?? "", file.default])
);

// Echte doosmaten (cm) per editie komen uit scripts/fetch_bgg_dimensions.py.
const boxDimensions = dimensionData as Record<string, { width: number; length: number; depth: number }>;

// Hoogte en dikte van de doos zoals hij rechtop op de plank staat, in cm. De cover bepaalt of de lange kant omhoog staat.
const boxShape = (game: BoardGame, ratio: number) => {
	const known = boxDimensions[game.id];
	if (known) {
		const long = Math.max(known.width, known.length);
		const short = Math.min(known.width, known.length);
		return { heightCm: ratio < 0.95 ? short : long, depthCm: Math.min(known.depth, short) };
	}
	// Zonder BGG-maten: een schatting op basis van complexiteit.
	const weight = game.weight ?? 0;
	const [face, depth] = game.categories?.includes("Card Game") && weight < 2.2 ? [18, 5] : weight >= 3 ? [30, 9] : weight >= 2.2 ? [28, 8] : [25, 6.5];
	return { heightCm: Math.round(face * Math.max(1, ratio)), depthCm: depth };
};

const shelfGames = games.map((game) => {
	const cover = covers.get(game.id);
	const ratio = cover ? cover.height / cover.width : 1;
	return {
		game,
		...boxShape(game, ratio),
		spine: spines.get(game.id)?.src,
		logo: logos.get(game.id)?.src,
		spineColor: spineColors[game.id]?.color ?? "#555555",
		src: cover?.src ?? game.thumbnail ?? game.image ?? "/images/placeholder-cover.png",
		width: cover?.width,
		height: cover?.height,
		search: [game.name, ...(game.categories ?? []), ...(game.mechanics ?? [])].join(" ").toLowerCase(),
	};
});

const meta: SiteMeta = {
	title: "Bordspellen",
	description: "De bordspellenkast van Daan Dobber.",
};
---

<PageLayout meta={meta}>
	<section class="game-document" aria-labelledby="games-title">
		<h1 id="games-title" class="sr-only">Bordspellen — {games.length} spellen</h1>

		<div class="game-tools">
			<button type="button" class="game-tools__toggle" aria-expanded="false" aria-haspopup="true" title="Zoeken en sorteren">
				<span aria-hidden="true">⌕</span>
			</button>
			<div class="game-tools__panel" hidden>
				<label class="game-tools__search">
					<span aria-hidden="true">⌕</span>
					<input type="search" placeholder="Zoek op naam of thema…" data-game-search aria-label="Zoek in de bordspellen" />
				</label>
				<p>Sorteren</p>
				<button type="button" data-game-sort="name" aria-pressed="true"><span aria-hidden="true">A→Z</span>Naam</button>
				<button type="button" data-game-sort="plays" aria-pressed="false"><span aria-hidden="true">#</span>Meest gespeeld</button>
				<button type="button" data-game-sort="rating" aria-pressed="false"><span aria-hidden="true">★</span>BGG-score</button>
				<button type="button" data-game-sort="weight" aria-pressed="false"><span aria-hidden="true">⚖</span>Zwaarste eerst</button>
				<button type="button" data-game-sort="shuffle" aria-pressed="false"><span aria-hidden="true">⟲</span>Willekeurig</button>
				<small class="game-tools__count" data-game-count aria-live="polite"></small>
			</div>
		</div>

		<div class="game-cabinet">
			<div class="game-shelves" data-game-shelves>
				{shelfGames.map(({ game, heightCm, depthCm, spine, logo, spineColor, src, width, height, search }) => (
					<div
						class="game-slot"
						data-name={game.name}
						data-plays={game.numplays ?? 0}
						data-rating={game.average_rating ?? 0}
						data-weight={game.weight ?? 0}
						data-search={search}
					>
						<a
							class="game-box"
							href={`https://boardgamegeek.com/boardgame/${game.id}`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={game.name}
							style={`--height: ${heightCm}; --depth: ${depthCm}; --spine-color: ${spineColor}`}
						>
							<span class="game-box__spine" aria-hidden="true">
								{spine ? (
									<img class="game-box__photo" src={spine} alt="" loading="lazy" decoding="async" />
								) : (
									logo && <img class="game-box__logo" src={logo} alt="" loading="lazy" decoding="async" />
								)}
							</span>
							<span class="game-box__front">
								<img src={src} width={width} height={height} alt={`Doos van ${game.name}`} loading="lazy" decoding="async" />
							</span>
						</a>
					</div>
				))}
				<span class="game-slot game-slot--filler" aria-hidden="true"></span>
			</div>
			<p class="game-empty" data-game-empty hidden>Geen spellen gevonden.</p>
		</div>
		<div class="game-cabinet__base" aria-hidden="true"></div>
	</section>
</PageLayout>

<script>
	const shelves = document.querySelector<HTMLElement>("[data-game-shelves]");
	if (shelves) {
		const slots = Array.from(shelves.querySelectorAll<HTMLElement>(".game-slot:not(.game-slot--filler)"));
		const filler = shelves.querySelector<HTMLElement>(".game-slot--filler");
		const searchInput = document.querySelector<HTMLInputElement>("[data-game-search]");
		const count = document.querySelector<HTMLElement>("[data-game-count]");
		const empty = document.querySelector<HTMLElement>("[data-game-empty]");
		const byName = (a: HTMLElement, b: HTMLElement) => (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "nl", { sensitivity: "base" });
		const byNumber = (key: "plays" | "rating" | "weight") => (a: HTMLElement, b: HTMLElement) =>
			Number(b.dataset[key]) - Number(a.dataset[key]) || byName(a, b);

		const shuffle = (list: HTMLElement[]) => {
			for (let index = list.length - 1; index > 0; index -= 1) {
				const randomIndex = Math.floor(Math.random() * (index + 1));
				const current = list[index];
				const random = list[randomIndex];
				if (current && random) [list[index], list[randomIndex]] = [random, current];
			}
		};

		const applyFilter = () => {
			const needle = (searchInput?.value ?? "").trim().toLowerCase();
			let visible = 0;
			for (const slot of slots) {
				slot.hidden = needle.length > 0 && !(slot.dataset.search ?? "").includes(needle);
				if (!slot.hidden) visible += 1;
			}
			if (count) count.textContent = `${visible} van ${slots.length} spellen`;
			if (empty) empty.hidden = visible > 0;
		};

		const sortSlots = (mode: string) => {
			if (mode === "shuffle") shuffle(slots);
			else if (mode === "plays" || mode === "rating" || mode === "weight") slots.sort(byNumber(mode));
			else slots.sort(byName);
			shelves.append(...slots);
			if (filler) shelves.append(filler);
		};

		searchInput?.addEventListener("input", applyFilter);
		const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-game-sort]"));
		for (const button of sortButtons) {
			button.addEventListener("click", () => {
				for (const other of sortButtons) other.setAttribute("aria-pressed", String(other === button));
				sortSlots(button.dataset.gameSort ?? "name");
			});
		}
		applyFilter();

		// De uitvergrote voorkant schuift zo nodig op, zodat hij bij de randen van het venster niet wegvalt.
		const keepFrontInView = (box: HTMLElement) => {
			const spine = box.querySelector<HTMLElement>(".game-box__spine");
			const front = box.querySelector<HTMLElement>(".game-box__front");
			if (!spine || !front) return;
			const rect = spine.getBoundingClientRect();
			const width = front.offsetWidth;
			const height = front.offsetHeight;
			const left = rect.left + rect.width / 2 - width / 2;
			const clampedLeft = Math.min(Math.max(8, left), window.innerWidth - width - 8);
			const top = rect.bottom - height - 14;
			box.style.setProperty("--shift-x", `${clampedLeft - left}px`);
			box.style.setProperty("--shift-y", `${Math.max(0, 8 - top)}px`);
		};

		const boxes = Array.from(shelves.querySelectorAll<HTMLElement>(".game-box"));
		const closeAll = (except?: HTMLElement) => { for (const box of boxes) if (box !== except) box.classList.remove("is-open"); };
		for (const box of boxes) {
			box.addEventListener("pointerenter", () => keepFrontInView(box));
			box.addEventListener("focus", () => keepFrontInView(box));
			// Op een touchscreen toont de eerste tik de voorkant; de tweede opent BoardGameGeek.
			box.addEventListener("click", (event) => {
				if (!matchMedia("(hover: none)").matches || box.classList.contains("is-open")) return;
				event.preventDefault();
				keepFrontInView(box);
				closeAll(box);
				box.classList.add("is-open");
			});
		}
		document.addEventListener("pointerdown", (event) => {
			if (!(event.target as Element).closest?.(".game-box")) closeAll();
		});

		const toggle = document.querySelector<HTMLButtonElement>(".game-tools__toggle");
		const panel = document.querySelector<HTMLElement>(".game-tools__panel");
		if (toggle && panel) {
			const setOpen = (open: boolean) => { panel.hidden = !open; toggle.setAttribute("aria-expanded", String(open)); };
			toggle.addEventListener("click", () => setOpen(panel.hidden));
			document.addEventListener("pointerdown", (event) => {
				if (!toggle.contains(event.target as Node) && !panel.contains(event.target as Node)) setOpen(false);
			});
			document.addEventListener("keydown", (event) => { if (event.key === "Escape") { setOpen(false); closeAll(); } });
		}
	}
</script>

<style>
	.game-document {
		--unit: clamp(6rem, 14vw, 10rem);
		--cm: calc(var(--unit) / 30); /* een doos van 30 cm is één unit hoog */
		--wood: #c99d68;
		--wood-light: #e0bd8e;
		--wood-dark: #9c7246;
		--wall: #f5efe4;
		--wall-shade: #e6dac6;
		min-height: 100%;
		color: #123d59;
	}
	:global([data-theme="dark"]) .game-document {
		--wood: #6b4c34;
		--wood-light: #87623f;
		--wood-dark: #48311f;
		--wall: #2b2724;
		--wall-shade: #1d1a18;
		color: #e8faff;
	}

	.game-tools { position: fixed; right: 1.5rem; bottom: 2.6rem; z-index: 40; }
	.game-tools__toggle {
		position: relative;
		display: grid;
		width: 3.5rem;
		height: 3.5rem;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 75%);
		border-radius: 50%;
		background: radial-gradient(circle at 32% 26%, #fff, rgb(255 255 255 / 65%) 28%, rgb(146 216 250 / 78%) 56%, rgb(47 145 219 / 88%) 100%);
		box-shadow:
			inset 0 2px 2px rgb(255 255 255 / 95%),
			inset 0 -8px 12px rgb(18 88 148 / 40%),
			0 3px 6px rgb(20 70 120 / 30%),
			0 12px 24px rgb(20 70 120 / 32%);
		color: #123d59;
		font-size: 1.3rem;
		cursor: pointer;
		animation: game-tools-bob 4.5s ease-in-out infinite;
		transition: transform .18s ease, box-shadow .18s ease;
	}
	.game-tools__toggle::before {
		content: "";
		position: absolute;
		top: 11%;
		left: 16%;
		width: 46%;
		height: 34%;
		border-radius: 50%;
		background: linear-gradient(180deg, rgb(255 255 255 / 92%), rgb(255 255 255 / 0%));
		pointer-events: none;
	}
	.game-tools__toggle:hover { animation-play-state: paused; transform: scale(1.08); }
	.game-tools__toggle[aria-expanded="true"] {
		animation-play-state: paused;
		box-shadow:
			inset 0 2px 2px rgb(255 255 255 / 95%),
			inset 0 -8px 12px rgb(18 88 148 / 40%),
			0 0 0 4px rgb(255 255 255 / 45%),
			0 12px 24px rgb(20 70 120 / 32%);
	}
	@keyframes game-tools-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-.4rem); }
	}
	.game-tools__panel { position: absolute; right: calc(100% + .8rem); bottom: 0; width: 14.5rem; padding: .55rem; border: 1px solid rgb(255 255 255 / 75%); border-radius: 1.2rem; background: linear-gradient(145deg, rgb(240 253 255 / 97%), rgb(186 224 246 / 95%), rgb(211 194 244 / 95%)); box-shadow: 0 20px 46px rgb(22 56 94 / 30%), inset 0 1px 0 #fff; backdrop-filter: blur(18px); }
	.game-tools__panel[hidden] { display: none; }
	.game-tools__search { display: flex; margin-bottom: .5rem; padding: .55rem .7rem; align-items: center; gap: .5rem; border: 1px solid rgb(255 255 255 / 60%); border-radius: .75rem; background: linear-gradient(180deg, rgb(255 255 255 / 55%), rgb(255 255 255 / 22%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 65%); }
	.game-tools__search input { flex: 1; min-width: 0; border: 0 !important; background: transparent !important; box-shadow: none !important; color: #143c5a; font: inherit; outline: none; }
	.game-tools__search input::placeholder { color: rgb(20 65 96 / 55%); }
	.game-tools__search input::-webkit-search-cancel-button { display: none; }
	.game-tools__panel p { margin: .25rem .15rem .35rem; color: rgb(20 65 96 / 62%); font-size: .58rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
	.game-tools__panel button { display: flex; width: 100%; align-items: center; gap: .6rem; padding: .5rem .65rem; border: 0; border-radius: .7rem; background: transparent; color: #143c5a; font-weight: 750; text-align: left; cursor: pointer; transition: background .12s ease; }
	.game-tools__panel button:hover,
	.game-tools__panel button[aria-pressed="true"] { background: linear-gradient(180deg, rgb(255 255 255 / 68%), rgb(255 255 255 / 32%)); }
	.game-tools__panel button span { min-width: 1.6rem; font-size: .62rem; font-weight: 900; opacity: .7; }
	.game-tools__count { display: block; margin: .4rem .2rem .1rem; color: rgb(20 65 96 / 62%); font-size: .68rem; font-weight: 700; }
	:global([data-theme="dark"]) .game-tools__toggle { color: #e8faff; background: radial-gradient(circle at 32% 26%, rgb(255 255 255 / 92%), rgb(180 232 255 / 55%) 26%, rgb(96 178 235 / 68%) 55%, rgb(62 55 150 / 88%) 100%); box-shadow: inset 0 2px 2px rgb(255 255 255 / 55%), inset 0 -8px 12px rgb(20 20 60 / 45%), 0 3px 6px rgb(0 0 0 / 30%), 0 12px 24px rgb(0 0 0 / 35%); }
	:global([data-theme="dark"]) .game-tools__panel { border-color: rgb(142 226 255 / 25%); background: linear-gradient(145deg, rgb(20 74 104 / 96%), rgb(52 45 118 / 96%), rgb(89 37 105 / 96%)); }
	:global([data-theme="dark"]) .game-tools__panel :is(p, button, input, small) { color: #e8faff; }
	:global([data-theme="dark"]) .game-tools__search { border-color: rgb(142 226 255 / 30%); background: linear-gradient(180deg, rgb(255 255 255 / 16%), rgb(255 255 255 / 6%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 22%); }
	:global([data-theme="dark"]) .game-tools__search input::placeholder { color: rgb(226 248 255 / 62%); }
	:global([data-theme="dark"]) .game-tools__panel button:hover,
	:global([data-theme="dark"]) .game-tools__panel button[aria-pressed="true"] { background: rgb(255 255 255 / 11%); }
	@media (prefers-reduced-motion: reduce) {
		.game-tools__toggle { animation: none; }
	}

	/* De kast: houten zijkanten en bovenblad rond een achterwand; elk spel draagt zijn eigen stuk plank zodat de planken doorlopen bij elke breedte. */
	.game-cabinet {
		position: relative;
		padding: 14px 14px 0;
		border-radius: .55rem .55rem 0 0;
		background:
			repeating-linear-gradient(90deg, rgb(0 0 0 / 0%) 0 7px, rgb(0 0 0 / 4%) 7px 8px, rgb(255 255 255 / 5%) 8px 15px),
			linear-gradient(180deg, var(--wood-light), var(--wood) 30%, var(--wood-dark));
		box-shadow: 0 16px 34px rgb(20 40 60 / 18%), inset 0 1px 0 rgb(255 255 255 / 35%);
	}
	.game-shelves {
		display: flex;
		flex-wrap: wrap;
		row-gap: 1.3rem;
		padding-top: 1.2rem;
		background:
			linear-gradient(90deg, rgb(0 0 0 / 22%), transparent 18px, transparent calc(100% - 18px), rgb(0 0 0 / 22%)),
			linear-gradient(180deg, rgb(0 0 0 / 20%), transparent 22px),
			repeating-linear-gradient(90deg, transparent 0 calc(var(--unit) * 1.6 - 1px), rgb(0 0 0 / 5%) calc(var(--unit) * 1.6 - 1px) calc(var(--unit) * 1.6)),
			linear-gradient(180deg, var(--wall), var(--wall-shade));
	}
	.game-slot {
		--plank-shadow: 13px;
		--plank-front: 24px;
		--plank-top: 38px;
		display: flex;
		flex: 1 0 auto;
		min-width: 0;
		align-items: flex-end;
		justify-content: center;
		padding: 0 1px calc(var(--plank-top) - 7px);
		background: linear-gradient(
			to top,
			rgb(0 0 0 / 0%) 0,
			rgb(0 0 0 / 26%) var(--plank-shadow),
			var(--wood-dark) var(--plank-shadow),
			var(--wood) calc(var(--plank-front) - 1px),
			rgb(255 255 255 / 45%) calc(var(--plank-front) - 1px),
			var(--wood-light) var(--plank-front),
			var(--wood-dark) var(--plank-top),
			transparent var(--plank-top)
		);
	}
	.game-slot[hidden] { display: none; }
	.game-slot--filler { flex: 1000 1 0; padding: 0; }
	.game-cabinet__base { height: 16px; margin: 0 6px; border-radius: 0 0 .35rem .35rem; background: linear-gradient(180deg, var(--wood-dark), color-mix(in srgb, var(--wood-dark) 70%, black)); box-shadow: 0 10px 18px rgb(20 40 60 / 22%); }
	.game-empty { margin: 0; padding: 0 1rem 1.2rem; font-weight: 700; text-align: center; background: var(--wall-shade); }

	/* Een doos staat met de zijkant naar voren: het logo van de cover, gedraaid, op de achtergrondkleur van dat logo. */
	.game-box { position: relative; display: block; color: inherit; text-decoration: none; outline: none; }
	.game-box__spine {
		position: relative;
		display: block;
		width: calc(var(--cm) * var(--depth));
		height: calc(var(--cm) * var(--height));
		overflow: hidden;
		border-radius: 2px;
		background: var(--spine-color);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 22%), 2px 3px 4px rgb(0 0 0 / 22%);
		transition: transform .2s ease, filter .2s ease;
	}
	.game-box__logo { position: absolute; inset: .5rem 9%; width: 82%; height: calc(100% - 1rem); object-fit: contain; }
	.game-box__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.game-box__spine::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgb(0 0 0 / 16%), transparent 5px, transparent calc(100% - 5px), rgb(0 0 0 / 20%)),
			linear-gradient(90deg, rgb(255 255 255 / 20%), rgb(255 255 255 / 0%) 22%, rgb(0 0 0 / 0%) 75%, rgb(0 0 0 / 26%));
		pointer-events: none;
	}
	.game-box:hover .game-box__spine,
	.game-box:focus-visible .game-box__spine,
	.game-box.is-open .game-box__spine { filter: brightness(1.12); transform: translateY(-.35rem); }
	.game-box:focus-visible .game-box__spine { box-shadow: 0 0 0 3px #4fb4f0; }

	/* De voorkant draait bij hover groot in beeld, vanuit de zijkant. */
	.game-box__front {
		position: absolute;
		z-index: 1;
		bottom: 0;
		left: 50%;
		width: min(calc(var(--unit) * 1.7), 15rem);
		overflow: hidden;
		border-radius: 3px;
		background: #c9c8c4;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 25%), 0 22px 40px rgb(10 30 50 / 45%), 0 6px 12px rgb(10 30 50 / 30%);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0) perspective(900px) rotateY(-82deg) scale(.3);
		transform-origin: bottom center;
		transition: transform .32s cubic-bezier(.2, .9, .3, 1.15), opacity .18s ease;
	}
	.game-box__front::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, rgb(255 255 255 / 26%), transparent 40%); pointer-events: none; }
	.game-box__front img { display: block; width: 100%; height: auto; }
	.game-box:hover,
	.game-box:focus-visible,
	.game-box.is-open { z-index: 10; }
	.game-box:hover .game-box__front,
	.game-box:focus-visible .game-box__front,
	.game-box.is-open .game-box__front {
		opacity: 1;
		transform: translate(calc(-50% + var(--shift-x, 0px)), calc(-.9rem + var(--shift-y, 0px))) perspective(900px) rotateY(0) scale(1);
	}
	@media (prefers-reduced-motion: reduce) {
		.game-box__spine,
		.game-box__front { transition: opacity .15s ease; }
	}
	@media (max-width: 600px) {
		.game-cabinet { padding-inline: 9px; }
		.game-tools { right: 1rem; bottom: 1.5rem; }
	}
</style>
