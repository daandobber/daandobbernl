---
import cdCollectionData from "@/data/cd_collection.json";
import PageLayout from "@/layouts/Base.astro";
import type { Release, SiteMeta } from "@/types";

const releases: Release[] = cdCollectionData?.releases ?? [];
const shelfSize = 6;
const shelves = Array.from({ length: Math.ceil(releases.length / shelfSize) }, (_, index) =>
	releases.slice(index * shelfSize, (index + 1) * shelfSize)
);
const artistName = (release: Release) =>
	release.basic_information?.artists?.map((artist) => artist.name).join(", ") || "Onbekende artiest";

const meta: SiteMeta = {
	title: "CD-collectie",
	description: "De cd-collectie van Daan Dobber.",
};
---

<PageLayout meta={meta}>
	<section class="collection-document" aria-labelledby="collection-title">
		<header class="collection-document__header">
			<div>
				<p>Collecties</p>
				<h1 id="collection-title">CD-collectie</h1>
			</div>
			<span>{releases.length} cd's</span>
		</header>

		<div class="cd-library" data-cd-library>
			{shelves.map((shelf) => (
				<section class="cd-shelf" aria-label="Plank met cd's">
					<div class="cd-shelf__items">
						{shelf.map((release) => {
							const info = release.basic_information;
							const title = info?.title ?? "Onbekend album";
							const artist = artistName(release);
							const cover = info?.cover_image ?? "/images/placeholder-cover.png";
							return (
								<a
									class="cd-case"
									href={`https://www.discogs.com/release/${info?.id ?? release.id}`}
									target="_blank"
									rel="noopener noreferrer"
									title={`${artist} — ${title}`}
								>
									<span class="cd-case__shell">
										<span class="cd-case__hinge" aria-hidden="true"></span>
										<span class="cd-case__art">
											<img src={cover} alt={`Hoes van ${title} door ${artist}`} loading="lazy" />
											<span class="cd-case__info">
												<strong>{title}</strong>
												<small>{artist}</small>
											</span>
										</span>
										<span class="cd-case__shine" aria-hidden="true"></span>
									</span>
								</a>
							);
						})}
					</div>
				</section>
			))}
		</div>
	</section>
</PageLayout>

<script>
	const library = document.querySelector<HTMLElement>("[data-cd-library]");
	if (library) {
		const cases = Array.from(library.querySelectorAll<HTMLElement>(".cd-case"));
		for (let index = cases.length - 1; index > 0; index -= 1) {
			const randomIndex = Math.floor(Math.random() * (index + 1));
			const currentCase = cases[index];
			const randomCase = cases[randomIndex];
			if (currentCase && randomCase) [cases[index], cases[randomIndex]] = [randomCase, currentCase];
		}
		const rows = Array.from(library.querySelectorAll<HTMLElement>(".cd-shelf__items"));
		rows.forEach((row, rowIndex) => {
			cases.slice(rowIndex * 6, rowIndex * 6 + 6).forEach((album) => row.append(album));
		});
	}
</script>

<style>
	.collection-document { min-height: 100%; color: #123d59; }
	.collection-document__header { display: flex; margin-bottom: 1.25rem; padding: .8rem 1rem; align-items: center; justify-content: space-between; border: 1px solid rgb(255 255 255 / 70%); border-radius: .9rem; background: linear-gradient(145deg, rgb(255 255 255 / 72%), rgb(197 237 250 / 48%)); box-shadow: inset 0 1px 0 #fff, 0 8px 20px rgb(31 91 126 / 10%); }
	.collection-document__header p { margin: 0 0 .12rem; color: rgb(18 61 89 / 58%); font-size: .55rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
	.collection-document__header h1 { margin: 0; font-size: 1.25rem; }
	.collection-document__header > span { padding: .3rem .55rem; border-radius: 999px; background: rgb(73 169 208 / 12%); font-size: .62rem; font-weight: 800; }
	.cd-library { display: grid; gap: 2.7rem; padding: .35rem 0 2rem; }
	.cd-shelf { position: relative; min-width: 0; padding: 0 1.7rem; border-bottom: 13px solid #24252a; isolation: isolate; }
	.cd-shelf::before { display: none; }
	.cd-shelf::after { content: ""; position: absolute; z-index: -1; right: 2.15rem; bottom: -13px; left: 2.15rem; height: 10px; background: transparent; box-shadow: 0 0 17px 5px rgb(0 0 0 / 70%); transform: perspective(150px) rotateX(-25deg); }
	.cd-shelf__items { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(6, minmax(5.4rem, 1fr)); gap: clamp(.55rem, 1.25vw, .9rem); align-items: end; border-bottom: 23px solid #303138; }
	.cd-shelf__items::before,
	.cd-shelf__items::after { content: ""; position: absolute; bottom: -23px; width: 0; height: 0; border-style: solid; }
	.cd-shelf__items::before { left: -1.7rem; border-width: 0 0 23px 1.7rem; border-color: transparent transparent #303138; }
	.cd-shelf__items::after { right: -1.7rem; border-width: 23px 0 0 1.7rem; border-color: transparent transparent transparent #303138; }
	.cd-case { position: relative; z-index: 2; display: block; min-width: 0; color: inherit; text-decoration: none; transform: translateY(18px); transform-origin: bottom center; transition: transform .22s ease, filter .22s ease; }
	.cd-case:hover,
	.cd-case:focus-visible { z-index: 3; outline: none; filter: drop-shadow(0 9px 8px rgb(13 45 67 / 35%)); transform: translateY(11px) scale(1.055); }
	.cd-case::after { content: ""; position: absolute; right: 0; bottom: -5px; left: 0; height: 10px; border-radius: 20px; background: rgb(0 0 0 / 30%); box-shadow: 0 0 20px rgb(0 0 0 / 50%); transform: perspective(600px) rotateX(100deg); }
	.cd-case__shell { position: relative; display: block; width: 100%; aspect-ratio: 1.084 / 1; overflow: hidden; border: 1px solid rgb(0 0 0 / 60%); border-radius: 0; background: rgb(255 255 255 / 15%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 28%); }
	.cd-case__shell::after { content: ""; position: absolute; z-index: 5; right: 1px; bottom: 0; left: 0; height: 1px; background: rgb(255 255 255 / 45%); }
	.cd-case__hinge { position: absolute; z-index: 3; inset: 0 auto 0 0; width: 10%; border-right: 1px solid rgb(0 0 0 / 60%); background: repeating-linear-gradient(90deg, rgb(68 68 68 / 92%) 0 2px, rgb(0 0 0 / 20%) 2px 3px); box-shadow: inset -1px 0 rgb(255 255 255 / 24%); }
	.cd-case__art { position: absolute; inset: 1px 1px 1px 10%; overflow: hidden; border: 1px solid rgb(0 0 0 / 60%); background: #c9c8c4; }
	.cd-case__art img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.cd-case__shine { position: absolute; z-index: 4; top: -30%; left: 35%; width: 38%; height: 165%; background: linear-gradient(90deg, transparent, rgb(255 255 255 / 24%), transparent); pointer-events: none; transform: rotate(25deg); }
	.cd-case__info { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; display: grid; gap: .08rem; padding: 1.25rem .38rem .32rem; color: #fff; line-height: 1.15; text-align: left; background: linear-gradient(transparent, rgb(3 10 15 / 88%)); opacity: 0; transform: translateY(.35rem); transition: opacity .2s ease, transform .2s ease; }
	.cd-case:hover .cd-case__info,
	.cd-case:focus-visible .cd-case__info { opacity: 1; transform: translateY(0); }
	.cd-case__info strong,
	.cd-case__info small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.cd-case__info strong { font-size: .58rem; }
	.cd-case__info small { color: rgb(255 255 255 / 76%); font-size: .49rem; }
	:global([data-theme="dark"]) .collection-document { color: #e8faff; }
	:global([data-theme="dark"]) .collection-document__header { border-color: rgb(157 225 247 / 20%); background: linear-gradient(145deg, rgb(39 113 143 / 38%), rgb(70 51 137 / 42%)); }
	:global([data-theme="dark"]) .collection-document__header p { color: rgb(222 246 255 / 62%); }
	:global([data-theme="dark"]) .collection-document__header > span { background: rgb(137 220 248 / 12%); }
	@media (max-width: 800px) {
		.cd-library { gap: 1.25rem; }
		.cd-shelf { overflow-x: auto; padding-inline: .8rem; scrollbar-width: thin; }
		.cd-shelf__items { min-width: 36rem; }
		.cd-shelf__items::before { left: -.8rem; border-left-width: .8rem; }
		.cd-shelf__items::after { right: -.8rem; border-left-width: .8rem; }
	}
	@media (max-width: 480px) {
		.collection-document__header { align-items: flex-start; }
		.collection-document__header h1 { font-size: 1.08rem; }
	}
</style>
