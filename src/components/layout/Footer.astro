---
import LastFmStatus from "@/components/LastFmStatus.svelte";
import ThemeToggle from "@/components/ThemeToggle.astro";
import WindowMenu from "@/components/WindowMenu.astro";
---

<footer class="aero-footer" aria-label="Aqua OS taakbalk">
	<WindowMenu />
	<div class="taskbar-running" id="taskbar-running" aria-label="Open vensters"></div>
	<div class="taskbar-tray">
		<div class="taskbar-lastfm">
			<svg class="taskbar-lastfm-logo" aria-label="Last.fm" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path fill="currentColor" d="M18.94 13.45a1.85 1.85 0 1 0 0 3.69 1.85 1.85 0 0 0 0-3.69Zm-4.23 0c-1.73 0-3.01 1.08-3.36 2.88-.31 1.58-1.51 2.67-3.15 2.67a3.16 3.16 0 1 1 1.74-5.78l.51-2.18a5.44 5.44 0 1 0 3.1 5.92c.19-.96.87-1.83 2.12-1.83a1.85 1.85 0 1 0 0-3.69c-.33 0-.65.04-.96.11Z" />
			</svg>
			<LastFmStatus embedded client:load />
		</div>
		<ThemeToggle />
	</div>
</footer>
