---
import tipsData from "@/data/clippy_tips.json";
---

<clippy-assistant class="clippy" data-tips={JSON.stringify(tipsData)}>
	<div class="clippy__bubble" data-clippy-bubble hidden>
		<button type="button" class="clippy__close" data-clippy-close aria-label="Sluiten">×</button>
		<p data-clippy-text></p>
	</div>
	<button type="button" class="clippy__character" data-clippy-character aria-label="Assistent">
		<span class="clippy__clip" aria-hidden="true">
			<span class="clippy__brow"></span>
			<span class="clippy__brow"></span>
			<span class="clippy__eye"></span>
			<span class="clippy__eye"></span>
		</span>
	</button>
</clippy-assistant>

<script>
	interface Tips {
		welcome: string;
		idle: string[];
		tips: Record<string, string>;
	}

	const MAX_UNPROMPTED_POPUPS = 4;
	const IDLE_DELAY_MIN_MS = 35_000;
	const IDLE_DELAY_MAX_MS = 70_000;

	class ClippyAssistant extends HTMLElement {
		connectedCallback() {
			if (window.self !== window.top) return;
			const root = this;
			let data: Tips = { welcome: "", idle: [], tips: {} };
			try {
				data = { idle: [], tips: {}, ...JSON.parse(root.dataset.tips ?? "{}") };
			} catch {
				data = { welcome: "", idle: [], tips: {} };
			}

			const bubble = root.querySelector<HTMLElement>("[data-clippy-bubble]");
			const textEl = root.querySelector<HTMLElement>("[data-clippy-text]");
			const closeBtn = root.querySelector<HTMLButtonElement>("[data-clippy-close]");
			const character = root.querySelector<HTMLButtonElement>("[data-clippy-character]");

			let welcomeShown = false;
			try {
				welcomeShown = sessionStorage.getItem("clippy-welcome-shown") === "1";
			} catch {
				welcomeShown = false;
			}
			let popupCount = 0;
			try {
				popupCount = Number(sessionStorage.getItem("clippy-popup-count") ?? "0") || 0;
			} catch {
				popupCount = 0;
			}

			let hideTimer: number | undefined;
			const say = (message: string) => {
				if (!bubble || !textEl || !message) return;
				window.clearTimeout(hideTimer);
				textEl.textContent = message;
				bubble.hidden = false;
				root.classList.add("is-talking");
				hideTimer = window.setTimeout(() => {
					bubble.hidden = true;
					root.classList.remove("is-talking");
				}, 9000);
			};

			let lastIdleIndex = -1;
			const pickIdleLine = (): string => {
				if (data.idle.length === 0) return data.welcome;
				let index = Math.floor(Math.random() * data.idle.length);
				if (index === lastIdleIndex) index = (index + 1) % data.idle.length;
				lastIdleIndex = index;
				return data.idle[index] ?? data.welcome;
			};

			closeBtn?.addEventListener("click", () => {
				window.clearTimeout(hideTimer);
				if (bubble) bubble.hidden = true;
				root.classList.remove("is-talking");
			});

			// Clicking Clippy himself always offers unsolicited "help", the way the
			// real thing never let you forget it was there.
			character?.addEventListener("click", () => say(pickIdleLine()));

			document.addEventListener("aqua-app-opened", ((event: CustomEvent<{ key?: string }>) => {
				const key = event.detail?.key;
				if (!key) return;
				const message = data.tips[key];
				if (!message) return;
				say(message);
			}) as EventListener);

			const scheduleIdlePopup = () => {
				if (popupCount >= MAX_UNPROMPTED_POPUPS || data.idle.length === 0) return;
				const delay = IDLE_DELAY_MIN_MS + Math.random() * (IDLE_DELAY_MAX_MS - IDLE_DELAY_MIN_MS);
				window.setTimeout(() => {
					// Don't interrupt an already-open bubble — just try again shortly.
					if (bubble && !bubble.hidden) {
						scheduleIdlePopup();
						return;
					}
					popupCount += 1;
					try {
						sessionStorage.setItem("clippy-popup-count", String(popupCount));
					} catch {
						/* storage unavailable, ignore */
					}
					say(pickIdleLine());
					scheduleIdlePopup();
				}, delay);
			};

			if (!welcomeShown && data.welcome) {
				try {
					sessionStorage.setItem("clippy-welcome-shown", "1");
				} catch {
					/* storage unavailable, ignore */
				}
				window.setTimeout(() => say(data.welcome), 1200);
			}
			scheduleIdlePopup();
		}
	}

	if (!customElements.get("clippy-assistant")) customElements.define("clippy-assistant", ClippyAssistant);
</script>

<style>
	.clippy {
		position: fixed;
		right: 1.5rem;
		bottom: 4.2rem;
		z-index: 1900;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: .6rem;
	}

	.clippy__character {
		position: relative;
		display: block;
		width: 4rem;
		height: 6.1rem;
		border: 0;
		background: transparent;
		cursor: pointer;
		animation: clippy-bob 3.4s ease-in-out infinite;
	}
	@keyframes clippy-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-.35rem); }
	}
	.clippy.is-talking .clippy__character { animation-play-state: paused; }

	/* The actual paperclip silhouette (three overlapping bent-wire loops), re-skinned
	   as glossy chrome over the classic silver-gray instead of flat gray. Proportions
	   follow the classic Clippy CSS-art construction: a bottom "U", an outer arch,
	   and a nested "U". */
	.clippy__clip {
		position: absolute;
		bottom: .43rem;
		left: 1.35rem;
		width: 1.71rem;
		height: 2.28rem;
		border: .21rem solid #cdd3d9;
		border-top: 0;
		border-radius: 0 0 2.28rem 2.28rem;
		box-sizing: border-box;
		box-shadow: inset 0 2px 3px rgb(255 255 255 / 75%), inset 0 -3px 4px rgb(20 20 25 / 28%), 0 3px 6px rgb(0 0 0 / 30%);
	}
	.clippy__clip::before {
		content: "";
		display: block;
		position: absolute;
		top: -2.85rem;
		left: -.21rem;
		width: 1.47rem;
		height: 2.85rem;
		border: .21rem solid #cdd3d9;
		border-bottom: 0;
		border-radius: 2.28rem 2.28rem 0 0;
		box-sizing: border-box;
		box-shadow: inset 0 2px 3px rgb(255 255 255 / 75%), inset 0 -3px 4px rgb(20 20 25 / 28%), 0 3px 6px rgb(0 0 0 / 25%);
	}
	.clippy__clip::after {
		content: "";
		display: block;
		position: absolute;
		top: -.47rem;
		left: .04rem;
		width: 1.24rem;
		height: 1.71rem;
		border: .21rem solid #cdd3d9;
		border-top: 0;
		border-radius: 0 0 2.28rem 2.28rem;
		box-sizing: border-box;
		box-shadow: inset 0 2px 3px rgb(255 255 255 / 75%), inset 0 -3px 4px rgb(20 20 25 / 28%), 0 3px 6px rgb(0 0 0 / 25%);
	}
	/* Two thick, angled dashes above the eyes — Clippy's most recognizable
	   feature, giving him that inquisitive "raised eyebrow" look. */
	.clippy__brow {
		position: absolute;
		top: -87%;
		left: -32%;
		width: 55%;
		height: 9%;
		border-radius: 999px;
		background: #2b2f33;
		box-shadow: 0 1px 0 rgb(255 255 255 / 35%);
		transform: rotate(-10deg);
		z-index: 2;
	}
	.clippy__brow + .clippy__brow { left: 48%; transform: rotate(10deg); }

	.clippy__eye {
		position: absolute;
		top: -75%;
		left: -35%;
		width: 75%;
		height: 35%;
		background: #fff;
		border-radius: 50%;
		z-index: 1;
		background-image: radial-gradient(circle, #1c1f22 15%, transparent 0);
		box-shadow: inset 0 .24rem 0 -.1rem #cdd3d9, inset 0 0 .19rem #cdd3d9;
		animation: clippy-blink 5s infinite;
	}
	.clippy__eye::before {
		content: "";
		display: block;
		position: absolute;
		top: -20%;
		width: 100%;
		height: 90%;
		border-radius: 50%;
		box-shadow: -.04rem -.19rem 0 -.04rem #1c1f22;
	}
	.clippy__eye + .clippy__eye { left: 45%; }
	.clippy__eye + .clippy__eye::before { box-shadow: .04rem -.19rem 0 -.04rem #1c1f22; }
	@keyframes clippy-blink {
		0%, 92%, 100% { transform: scaleY(1); }
		95% { transform: scaleY(.15); }
	}

	.clippy__bubble {
		position: relative;
		max-width: 15.5rem;
		padding: .7rem .9rem;
		border: 1px solid rgb(255 255 255 / 70%);
		border-radius: 1rem;
		background: linear-gradient(145deg, rgb(235 253 255 / 96%), rgb(186 224 246 / 94%), rgb(211 194 244 / 94%));
		box-shadow: 0 14px 32px rgb(22 56 94 / 26%), inset 0 1px 0 #fff;
		backdrop-filter: blur(16px);
		color: #143c5a;
		font-size: .75rem;
		font-weight: 600;
		line-height: 1.4;
	}
	.clippy__bubble[hidden] { display: none; }
	.clippy__bubble::after {
		content: "";
		position: absolute;
		right: 1.1rem;
		bottom: -.5rem;
		width: .9rem;
		height: .9rem;
		border-radius: 0 0 .25rem;
		background: rgb(211 194 244 / 94%);
		transform: rotate(45deg);
	}
	.clippy__bubble p { margin: 0; padding-right: 1rem; }
	.clippy__close {
		position: absolute;
		top: .3rem;
		right: .35rem;
		display: grid;
		place-items: center;
		width: 1.1rem;
		height: 1.1rem;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 55%);
		color: #143c5a;
		font-size: .8rem;
		line-height: 1;
		cursor: pointer;
	}
	.clippy__close:hover { background: rgb(255 255 255 / 80%); }

	:global([data-theme="dark"]) .clippy__bubble {
		border-color: rgb(142 226 255 / 25%);
		background: linear-gradient(145deg, rgb(20 74 104 / 96%), rgb(52 45 118 / 96%), rgb(89 37 105 / 96%));
		color: #e8faff;
	}
	:global([data-theme="dark"]) .clippy__bubble::after { background: rgb(89 37 105 / 96%); }
	:global([data-theme="dark"]) .clippy__close { background: rgb(255 255 255 / 12%); color: #e8faff; }
	:global([data-theme="dark"]) .clippy__close:hover { background: rgb(255 255 255 / 22%); }

	@media (max-width: 640px) {
		.clippy { right: .75rem; bottom: 3.8rem; }
		.clippy__bubble { max-width: 11rem; }
	}
</style>
