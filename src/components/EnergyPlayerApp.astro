---
import videoData from "@/data/youtube_favorites.json";

interface Video {
	id: string;
	title: string;
}

interface VideoEntry {
	id?: string;
	url?: string;
	title: string;
}

function extractYouTubeId(entry: VideoEntry): string | null {
	if (entry.id) return entry.id;
	if (!entry.url) return null;
	const match = entry.url.match(/(?:v=|\/embed\/|youtu\.be\/|\/shorts\/)([\w-]{11})/);
	return match?.[1] ?? null;
}

const videos: Video[] = ((videoData?.videos ?? []) as VideoEntry[])
	.map((entry) => ({ id: extractYouTubeId(entry), title: entry.title }))
	.filter((video): video is Video => !!video.id);
const first = videos[0];
---

<energy-player class="wmp" data-app="videospeler" data-videos={JSON.stringify(videos)} hidden>
	<div class="wmp__titlebar" data-wmp-drag-handle>
		<div class="wmp__titlebar-icon" aria-hidden="true">▶</div>
		<span class="wmp__titlebar-text">Media Player</span>
		<div class="wmp__capbtns">
			<button type="button" class="wmp__capbtn wmp__capbtn--min" data-ep-min aria-label="Minimaliseren"></button>
			<button type="button" class="wmp__capbtn wmp__capbtn--restore" data-ep-restore aria-label="Herstellen"></button>
			<button type="button" class="wmp__capbtn wmp__capbtn--close" data-ep-close aria-label="Sluiten"></button>
		</div>
	</div>

	<div class="wmp__main">
		<div class="wmp__taskbar">
			<button type="button" class="wmp__navbtn is-active" data-wmp-nav="now-playing">Nu aan<br />het afspelen</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Media<br />Guide</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Kopiëren<br />van cd</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Media-<br />bibliotheek</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Radio-<br />gids</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Kopiëren<br />naar cd</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Premium-<br />services</button>
			<button type="button" class="wmp__navbtn" data-wmp-nav disabled title="Niet beschikbaar in deze demo">Skin<br />Chooser</button>
		</div>

		<div class="wmp__content">
			<div class="wmp__screen">
				<div class="wmp__poster" data-ep-poster style={first ? `background-image:url(https://i.ytimg.com/vi/${first.id}/hqdefault.jpg)` : ""}>
					<button type="button" class="wmp__playposter" data-ep-playposter aria-label="Video afspelen"><span aria-hidden="true">▶</span></button>
				</div>
				<div class="wmp__videoslot" data-ep-videoslot hidden></div>
				<button type="button" class="wmp__pausecover" data-ep-pausecover aria-label="Verdergaan met afspelen" hidden>
					<span aria-hidden="true">▶</span>
				</button>
				<div class="wmp__screen-header" data-ep-header>
					<strong data-ep-title>{first?.title ?? "Geen video's toegevoegd"}</strong>
					<span>Media Player</span>
				</div>
			</div>

			<div class="wmp__playlist">
				<div class="wmp__playlist-header">Nu afspelen</div>
				<div class="wmp__playlist-list" data-ep-playlist>
					{videos.map((video, index) => (
						<button type="button" class="wmp__playlist-item" data-ep-track={index} aria-pressed={index === 0 ? "true" : "false"}>
							<span class="wmp__playlist-item-num">{index + 1}</span>
							<span class="wmp__playlist-item-title">{video.title}</span>
						</button>
					))}
				</div>
				<div class="wmp__playlist-tools">
					<button type="button" data-ep-shuffle title="Willekeurige video" aria-label="Willekeurige video"><i class="wmp__icon-shuffle" aria-hidden="true"></i></button>
					<button type="button" data-ep-open title="Bekijk op YouTube" aria-label="Bekijk op YouTube"><i class="wmp__icon-open" aria-hidden="true"></i></button>
				</div>
			</div>
		</div>
	</div>

	<div class="wmp__seekrow">
		<span class="wmp__time" data-ep-time>0:00</span>
		<input type="range" class="wmp__seek" data-ep-seek min="0" max="1000" value="0" aria-label="Zoeken in video" />
		<span class="wmp__time" data-ep-total>0:00</span>
	</div>

	<div class="wmp__transport">
		<button type="button" class="wmp__tbtn" data-ep-prev aria-label="Vorige"><i class="wmp__icon-prev" aria-hidden="true"></i></button>
		<button type="button" class="wmp__tbtn wmp__tbtn--play" data-ep-playbig aria-label="Afspelen of pauzeren" aria-pressed="false">
			<i class="wmp__icon-play" aria-hidden="true"></i>
		</button>
		<button type="button" class="wmp__tbtn" data-ep-stop aria-label="Stoppen"><i class="wmp__icon-stop" aria-hidden="true"></i></button>
		<button type="button" class="wmp__tbtn" data-ep-next aria-label="Volgende"><i class="wmp__icon-next" aria-hidden="true"></i></button>
		<div class="wmp__spacer"></div>
		<button type="button" class="wmp__tbtn wmp__tbtn--mute" data-ep-mute aria-label="Dempen" aria-pressed="false"><i class="wmp__icon-mute" aria-hidden="true"></i></button>
		<input type="range" class="wmp__volume" data-ep-volume min="0" max="100" value="100" aria-label="Volume" />
	</div>

	<div class="wmp__statusbar">
		<span data-ep-status>Gereed</span>
	</div>
</energy-player>

<script>
	interface Video { id: string; title: string }

	class EnergyPlayer extends HTMLElement {
		#taskButton: HTMLButtonElement | null = null;
		#zLayer = 1950;

		connectedCallback() {
			if (window.self !== window.top) return;
			const root = this;
			let videos: Video[] = [];
			try {
				videos = JSON.parse(root.dataset.videos ?? "[]");
			} catch {
				videos = [];
			}

			this.setupWindowControls();
			this.setupDrag();

			if (videos.length === 0) return;

			let currentIndex = 0;
			let player: YTPlayerLike | null = null;
			let isDraggingSeek = false;

			const titleEl = root.querySelector<HTMLElement>("[data-ep-title]");
			const timeEl = root.querySelector<HTMLElement>("[data-ep-time]");
			const totalEl = root.querySelector<HTMLElement>("[data-ep-total]");
			const statusEl = root.querySelector<HTMLElement>("[data-ep-status]");
			const seekEl = root.querySelector<HTMLInputElement>("[data-ep-seek]");
			const posterEl = root.querySelector<HTMLElement>("[data-ep-poster]");
			const videoSlot = root.querySelector<HTMLElement>("[data-ep-videoslot]");
			const pauseCoverEl = root.querySelector<HTMLButtonElement>("[data-ep-pausecover]");
			const headerEl = root.querySelector<HTMLElement>("[data-ep-header]");
			const playBigBtn = root.querySelector<HTMLButtonElement>("[data-ep-playbig]");
			const muteBtn = root.querySelector<HTMLButtonElement>("[data-ep-mute]");
			const volumeEl = root.querySelector<HTMLInputElement>("[data-ep-volume]");
			const trackButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ep-track]"));

			const formatTime = (seconds: number) => {
				const total = Math.max(0, Math.floor(seconds));
				const m = Math.floor(total / 60);
				const s = total % 60;
				return `${m}:${String(s).padStart(2, "0")}`;
			};

			let headerTimer: number | undefined;
			const showHeader = () => {
				window.clearTimeout(headerTimer);
				headerEl?.classList.remove("is-faded");
			};
			const scheduleHeaderFade = () => {
				window.clearTimeout(headerTimer);
				headerTimer = window.setTimeout(() => headerEl?.classList.add("is-faded"), 5000);
			};

			const setPlayingState = (playing: boolean) => {
				root.classList.toggle("is-playing", playing);
				playBigBtn?.setAttribute("aria-pressed", String(playing));
				if (statusEl) statusEl.textContent = playing ? "Bezig met afspelen" : "Onderbroken";
				const hasStarted = videoSlot ? !videoSlot.hidden : false;
				if (pauseCoverEl) pauseCoverEl.hidden = playing || !hasStarted;
				if (playing) scheduleHeaderFade();
				else showHeader();
			};

			const highlightTrack = (index: number) => {
				for (const button of trackButtons) button.setAttribute("aria-pressed", String(Number(button.dataset.epTrack) === index));
			};

			const setThumbnail = (video: Video) => {
				const url = `url(https://i.ytimg.com/vi/${video.id}/hqdefault.jpg)`;
				if (posterEl) posterEl.style.backgroundImage = url;
				if (pauseCoverEl) pauseCoverEl.style.backgroundImage = url;
			};

			const showPoster = (video: Video) => {
				setThumbnail(video);
				if (posterEl) posterEl.hidden = false;
				if (videoSlot) videoSlot.hidden = true;
				setPlayingState(false);
				if (timeEl) timeEl.textContent = "0:00";
				if (totalEl) totalEl.textContent = "0:00";
				if (seekEl) seekEl.value = "0";
				if (statusEl) statusEl.textContent = "Gereed";
			};

			const loadVideo = (index: number, autoplay: boolean) => {
				const video = videos[index];
				if (!video) return;
				currentIndex = index;
				highlightTrack(index);
				if (titleEl) titleEl.textContent = video.title;
				showHeader();
				if (!player) {
					showPoster(video);
					return;
				}
				setThumbnail(video);
				if (posterEl) posterEl.hidden = true;
				if (videoSlot) videoSlot.hidden = false;
				if (autoplay) player.loadVideoById(video.id);
				else player.cueVideoById(video.id);
			};

			const ensurePlayer = (autoplay: boolean) => {
				if (player || !videoSlot) return;
				const mount = document.createElement("div");
				videoSlot.append(mount);
				player = new window.YT.Player(mount, {
					videoId: videos[currentIndex]?.id,
					host: "https://www.youtube-nocookie.com",
					playerVars: { autoplay: autoplay ? 1 : 0, playsinline: 1, rel: 0, modestbranding: 1, controls: 0, disablekb: 1, fs: 0, iv_load_policy: 3 },
					events: {
						onReady: () => {
							if (posterEl) posterEl.hidden = true;
							if (videoSlot) videoSlot.hidden = false;
							if (totalEl && player) totalEl.textContent = formatTime(player.getDuration());
							window.setInterval(() => {
								if (!player || isDraggingSeek) return;
								const duration = player.getDuration() || 0;
								const current = player.getCurrentTime() || 0;
								if (timeEl) timeEl.textContent = formatTime(current);
								if (totalEl) totalEl.textContent = formatTime(duration);
								if (seekEl && duration > 0) seekEl.value = String(Math.round((current / duration) * 1000));
							}, 500);
						},
						onStateChange: (event: { data: number }) => {
							setPlayingState(event.data === 1);
						},
					},
				});
			};

			let apiLoading = false;
			const startPlayback = () => {
				if (player) {
					player.playVideo();
					return;
				}
				if (window.YT?.Player) {
					ensurePlayer(true);
					return;
				}
				const previousReady = window.onYouTubeIframeAPIReady;
				window.onYouTubeIframeAPIReady = () => {
					previousReady?.();
					ensurePlayer(true);
				};
				if (!apiLoading) {
					apiLoading = true;
					const tag = document.createElement("script");
					tag.src = "https://www.youtube.com/iframe_api";
					document.head.append(tag);
				}
			};

			playBigBtn?.addEventListener("click", () => {
				if (!player) {
					startPlayback();
					return;
				}
				const state = player.getPlayerState();
				if (state === 1) player.pauseVideo();
				else player.playVideo();
			});

			root.querySelector<HTMLButtonElement>("[data-ep-playposter]")?.addEventListener("click", startPlayback);
			pauseCoverEl?.addEventListener("click", () => player?.playVideo());

			root.querySelector<HTMLButtonElement>("[data-ep-stop]")?.addEventListener("click", () => {
				if (!player) return;
				player.stopVideo();
				setPlayingState(false);
				if (timeEl) timeEl.textContent = "0:00";
				if (seekEl) seekEl.value = "0";
			});

			root.querySelector<HTMLButtonElement>("[data-ep-next]")?.addEventListener("click", () => {
				const wasPlaying = root.classList.contains("is-playing");
				loadVideo((currentIndex + 1) % videos.length, wasPlaying || !!player);
			});

			root.querySelector<HTMLButtonElement>("[data-ep-prev]")?.addEventListener("click", () => {
				const wasPlaying = root.classList.contains("is-playing");
				loadVideo((currentIndex - 1 + videos.length) % videos.length, wasPlaying || !!player);
			});

			root.querySelector<HTMLButtonElement>("[data-ep-shuffle]")?.addEventListener("click", () => {
				const wasPlaying = root.classList.contains("is-playing");
				let next = currentIndex;
				if (videos.length > 1) while (next === currentIndex) next = Math.floor(Math.random() * videos.length);
				loadVideo(next, wasPlaying || !!player);
			});

			for (const button of trackButtons) button.addEventListener("click", () => {
				const wasPlaying = root.classList.contains("is-playing");
				loadVideo(Number(button.dataset.epTrack), wasPlaying || !!player);
			});

			root.querySelector<HTMLButtonElement>("[data-ep-open]")?.addEventListener("click", () => {
				const video = videos[currentIndex];
				if (video) window.open(`https://www.youtube.com/watch?v=${video.id}`, "_blank", "noopener");
			});

			muteBtn?.addEventListener("click", () => {
				if (!player) return;
				const muted = player.isMuted();
				if (muted) player.unMute();
				else player.mute();
				muteBtn.setAttribute("aria-pressed", String(!muted));
			});

			seekEl?.addEventListener("pointerdown", () => { isDraggingSeek = true; });
			seekEl?.addEventListener("pointerup", () => {
				isDraggingSeek = false;
				if (!player || !seekEl) return;
				const duration = player.getDuration() || 0;
				player.seekTo((Number(seekEl.value) / 1000) * duration, true);
			});

			volumeEl?.addEventListener("input", () => {
				player?.setVolume(Number(volumeEl.value));
			});

			for (const button of root.querySelectorAll<HTMLButtonElement>("[data-wmp-nav][disabled]")) {
				button.addEventListener("click", () => {
					if (statusEl) statusEl.textContent = "Niet beschikbaar in deze demo";
				});
			}

			new MutationObserver(() => {
				if (root.hidden) player?.pauseVideo();
			}).observe(root, { attributes: true, attributeFilter: ["hidden"] });

			showPoster(videos[0]);
		}

		setupWindowControls() {
			const root = this;

			root.querySelector<HTMLButtonElement>("[data-ep-close]")?.addEventListener("click", () => {
				root.hidden = true;
			});
			root.querySelector<HTMLButtonElement>("[data-ep-min]")?.addEventListener("click", () => {
				root.classList.add("is-minimized");
				this.#taskButton?.classList.remove("is-active");
			});
			root.querySelector<HTMLButtonElement>("[data-ep-restore]")?.addEventListener("click", () => {
				root.classList.toggle("is-maximized");
				root.classList.remove("is-minimized");
				this.raiseSelf();
			});
			root.addEventListener("pointerdown", () => this.raiseSelf());

			const ensureTaskButton = () => {
				if (this.#taskButton) return;
				const taskbar = document.querySelector<HTMLElement>("#taskbar-running");
				if (!taskbar) return;
				const button = document.createElement("button");
				button.type = "button";
				button.className = "taskbar-window-button";
				button.innerHTML = `<span aria-hidden="true">▶</span><span>Media Player</span>`;
				button.title = "Media Player";
				button.addEventListener("click", () => {
					const isActive = button.classList.contains("is-active");
					if (!root.hidden && !root.classList.contains("is-minimized") && isActive) {
						root.classList.add("is-minimized");
						button.classList.remove("is-active");
						return;
					}
					root.hidden = false;
					root.classList.remove("is-minimized");
					this.raiseSelf();
				});
				taskbar.append(button);
				this.#taskButton = button;
			};

			const observer = new MutationObserver(() => {
				if (root.hidden) {
					this.#taskButton?.remove();
					this.#taskButton = null;
					root.classList.remove("is-minimized", "is-maximized");
				} else {
					ensureTaskButton();
					this.raiseSelf();
				}
			});
			observer.observe(root, { attributes: true, attributeFilter: ["hidden"] });

			if (!root.hidden) ensureTaskButton();
		}

		raiseSelf() {
			this.#zLayer += 1;
			this.style.zIndex = String(this.#zLayer);
			this.#taskButton?.classList.toggle("is-active", !this.hidden && !this.classList.contains("is-minimized"));
		}

		setupDrag() {
			const root = this;
			const handle = root.querySelector<HTMLElement>("[data-wmp-drag-handle]");
			handle?.addEventListener("pointerdown", (event) => {
				if ((event.target as HTMLElement).closest("button")) return;
				const rect = root.getBoundingClientRect();
				const startLeft = rect.left;
				const startTop = rect.top;
				const startX = event.clientX;
				const startY = event.clientY;
				root.style.left = `${startLeft}px`;
				root.style.top = `${startTop}px`;
				handle.setPointerCapture(event.pointerId);
				const move = (moveEvent: PointerEvent) => {
					root.style.left = `${startLeft + moveEvent.clientX - startX}px`;
					root.style.top = `${startTop + moveEvent.clientY - startY}px`;
				};
				handle.addEventListener("pointermove", move);
				handle.addEventListener("pointerup", () => handle.removeEventListener("pointermove", move), { once: true });
			});
		}
	}

	interface YTPlayerLike {
		playVideo(): void;
		pauseVideo(): void;
		stopVideo(): void;
		loadVideoById(id: string): void;
		cueVideoById(id: string): void;
		seekTo(seconds: number, allowSeekAhead: boolean): void;
		getCurrentTime(): number;
		getDuration(): number;
		getPlayerState(): number;
		mute(): void;
		unMute(): void;
		isMuted(): boolean;
		setVolume(volume: number): void;
	}

	declare global {
		interface Window {
			YT?: { Player: new (el: HTMLElement, opts: Record<string, unknown>) => YTPlayerLike };
			onYouTubeIframeAPIReady?: () => void;
		}
	}

	if (!customElements.get("energy-player")) customElements.define("energy-player", EnergyPlayer);
</script>

<style>
	/* Classic "Media Player" layout (plain rectangular window, left-hand
	   taskbar of tabs, transport bar) reskinned in the site's Frutiger Aero glass
	   language: translucent blue/violet gradients, backdrop blur, organic aero
	   traffic-light buttons, and a light/dark palette matching the rest of the OS. */
	.wmp {
		--ink: #14345c;
		position: fixed;
		top: 4.5rem;
		left: calc(50% - 380px);
		z-index: 1950;
		display: flex;
		flex-direction: column;
		width: 760px;
		height: 520px;
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 80%);
		border-radius: 1.1rem;
		background: linear-gradient(135deg, rgb(80 193 235 / 34%), rgb(232 184 255 / 28%));
		box-shadow:
			inset 1px 1px 1px rgb(255 255 255 / 88%),
			inset -1px -1px 2px rgb(38 79 111 / 24%),
			0 24px 55px rgb(28 83 126 / 26%);
		backdrop-filter: blur(18px) saturate(150%);
		font-family: "Segoe UI", system-ui, sans-serif;
		color: var(--ink);
	}
	.wmp[hidden] { display: none; }
	.wmp.is-minimized { display: none; }
	.wmp.is-maximized {
		position: fixed !important;
		inset: 0 0 3.1rem 0 !important;
		left: 0 !important;
		top: 0 !important;
		width: 100vw !important;
		height: calc(100vh - 3.1rem) !important;
		border-radius: 0 !important;
	}
	:global([data-theme="dark"]) .wmp {
		--ink: #e8faff;
		border-color: rgb(142 226 255 / 26%);
		background: linear-gradient(135deg, rgb(18 132 177 / 58%), rgb(67 67 171 / 52%), rgb(125 48 137 / 48%));
		box-shadow: inset 1px 1px 1px rgb(217 250 255 / 18%), 0 24px 55px rgb(0 0 0 / 45%);
	}

	.wmp__titlebar {
		position: relative;
		display: flex;
		flex: none;
		align-items: center;
		gap: 8px;
		height: 34px;
		padding: 0 10px;
		border-bottom: 1px solid rgb(83 145 178 / 32%);
		background: linear-gradient(180deg, rgb(255 255 255 / 64%), rgb(150 224 248 / 36%));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 95%);
		cursor: grab;
	}
	.wmp__titlebar::before {
		content: "";
		position: absolute;
		inset: 1px 10px auto;
		height: 45%;
		border-radius: 999px;
		background: linear-gradient(180deg, rgb(255 255 255 / 45%), transparent);
		pointer-events: none;
	}
	.wmp__titlebar:active { cursor: grabbing; }
	:global([data-theme="dark"]) .wmp__titlebar { border-bottom-color: rgb(160 226 255 / 20%); background: linear-gradient(180deg, rgb(132 226 255 / 34%), rgb(47 97 160 / 52%), rgb(83 48 137 / 48%)); }
	.wmp__titlebar-icon { position: relative; z-index: 1; display: grid; place-items: center; width: 16px; height: 16px; color: var(--ink); font-size: 9px; text-shadow: 0 1px 0 rgb(255 255 255 / 75%); }
	.wmp__titlebar-text { position: relative; z-index: 1; flex: 1; overflow: hidden; color: var(--ink); font-size: 12px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 1px 0 rgb(255 255 255 / 75%); }
	:global([data-theme="dark"]) .wmp__titlebar-icon,
	:global([data-theme="dark"]) .wmp__titlebar-text { text-shadow: 0 1px 1px rgb(0 0 0 / 65%); }
	.wmp__capbtns { position: relative; z-index: 1; display: flex; flex: none; gap: 8px; }
	.wmp__capbtn {
		position: relative;
		width: 18px;
		height: 18px;
		border: 1px solid rgb(0 0 0 / 18%);
		border-radius: 50% 46% 50% 44%;
		background: radial-gradient(circle at 35% 24%, #effcff, #8dd9ed 48%, #5785b6);
		box-shadow: inset 0 2px 2px rgb(255 255 255 / 78%), inset 0 -2px 3px rgb(0 0 0 / 12%), 0 2px 4px rgb(0 0 0 / 20%);
		padding: 0;
		cursor: pointer;
		transition: transform .15s ease, filter .15s ease;
	}
	.wmp__capbtn:hover { filter: brightness(1.08) saturate(1.15); transform: scale(1.08); }
	.wmp__capbtn::before,
	.wmp__capbtn::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 8px;
		height: 1px;
		border-radius: 2px;
		background: rgb(38 55 63 / 72%);
