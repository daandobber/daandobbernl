---
import repoData from "@/data/github_repos.json";
import documentData from "@/data/documents.json";

interface RepoRef {
	owner: string;
	name: string;
}

interface DocumentRef {
	title: string;
	path: string;
}

const repos: RepoRef[] = repoData?.repos ?? [];
const documents: DocumentRef[] = documentData?.documents ?? [];
---

<explorer-app class="ghb" data-app="explorer" data-repos={JSON.stringify(repos)} data-documents={JSON.stringify(documents)} hidden>
	<div class="ghb__titlebar" data-ghb-drag-handle>
		<div class="ghb__titlebar-icon" aria-hidden="true">⌂</div>
		<span class="ghb__titlebar-text">Verkenner</span>
		<div class="ghb__capbtns">
			<button type="button" class="ghb__capbtn ghb__capbtn--min" data-ghb-min aria-label="Minimaliseren"></button>
			<button type="button" class="ghb__capbtn ghb__capbtn--restore" data-ghb-restore aria-label="Herstellen"></button>
			<button type="button" class="ghb__capbtn ghb__capbtn--close" data-ghb-close aria-label="Sluiten"></button>
		</div>
	</div>

	<div class="ghb__toolbar">
		<button type="button" class="ghb__navbtn ghb__navbtn--back" data-ghb-back aria-label="Terug" disabled></button>
		<button type="button" class="ghb__navbtn ghb__navbtn--forward" data-ghb-forward aria-label="Vooruit" disabled></button>
		<div class="ghb__addressbar">
			<span class="ghb__addressbar-icon" aria-hidden="true">⌂</span>
			<div class="ghb__breadcrumb" data-ghb-breadcrumb aria-label="Locatie"></div>
		</div>
		<button type="button" class="ghb__navbtn ghb__navbtn--refresh" data-ghb-refresh aria-label="Vernieuwen">⟳</button>
		<input type="search" class="ghb__search" data-ghb-search placeholder="Zoeken..." aria-label="Zoeken in deze map" />
	</div>

	<div class="ghb__actionbar" data-ghb-actions hidden>
		<button type="button" data-ghb-clone title="Kopieer git clone-commando">⧉ Clone</button>
		<a data-ghb-zip href="#" target="_blank" rel="noopener" title="Download ZIP">⇩ ZIP</a>
		<a data-ghb-github href="#" target="_blank" rel="noopener" title="Bekijk op GitHub">↗ GitHub</a>
	</div>

	<div class="ghb__body">
		<div class="ghb__sidebar">
			<div class="ghb__tree" data-ghb-tree></div>
		</div>
		<div class="ghb__content">
			<div class="ghb__grid" data-ghb-grid></div>
			<div class="ghb__viewer" data-ghb-viewer hidden>
				<div class="ghb__viewer-head" data-ghb-viewer-name></div>
				<div class="ghb__viewer-scroll"><pre class="ghb__viewer-content" data-ghb-viewer-content></pre></div>
			</div>
			<p class="ghb__message" data-ghb-message hidden></p>
		</div>
	</div>

	<div class="ghb__statusbar">
		<span data-ghb-status>Gereed</span>
	</div>
</explorer-app>

<script>
	interface RepoRef { owner: string; name: string }
	interface DocumentRef { title: string; path: string }
	interface TreeEntry { name: string; path: string; type: "file" | "dir"; download_url: string | null; size: number }
	type Loc =
		| { kind: "root" }
		| { kind: "documents" }
		| { kind: "repo"; owner: string; name: string; defaultBranch: string; htmlUrl: string };

	interface TreeChildSpec {
		key: string;
		label: string;
		onSelect: () => void | Promise<void>;
		onExpand?: () => Promise<TreeChildSpec[]>;
	}

	const IMAGE_EXTENSIONS = /\.(png|jpe?g|gif|webp|svg|bmp|ico)$/i;
	const MAX_PREVIEW_BYTES = 300_000;

	class ExplorerApp extends HTMLElement {
		#taskButton: HTMLButtonElement | null = null;
		#zLayer = 1950;
		#cache = new Map<string, unknown>();
		#repos: RepoRef[] = [];
		#documents: DocumentRef[] = [];
		#currentLocation: Loc = { kind: "root" };
		#currentPath = "";
		#history: (() => void | Promise<void>)[] = [];
		#historyIndex = -1;

		connectedCallback() {
			if (window.self !== window.top) return;
			try {
				this.#repos = JSON.parse(this.dataset.repos ?? "[]");
			} catch {
				this.#repos = [];
			}
			try {
				this.#documents = JSON.parse(this.dataset.documents ?? "[]");
			} catch {
				this.#documents = [];
			}

			this.setupWindowControls();
			this.setupDrag();
			this.setupBrowser();
		}

		async fetchJson(url: string): Promise<any | null> {
			if (this.#cache.has(url)) return this.#cache.get(url);
			try {
				const response = await fetch(url, { headers: { Accept: "application/vnd.github+json" } });
				if (!response.ok) throw new Error(`GitHub API ${response.status}`);
				const data = await response.json();
				this.#cache.set(url, data);
				return data;
			} catch (error) {
				if (import.meta.env.DEV) console.error(error);
				return null;
			}
		}

		setupBrowser() {
			const root = this;
			const grid = root.querySelector<HTMLElement>("[data-ghb-grid]");
			const viewer = root.querySelector<HTMLElement>("[data-ghb-viewer]");
			const viewerName = root.querySelector<HTMLElement>("[data-ghb-viewer-name]");
			const viewerContent = root.querySelector<HTMLElement>("[data-ghb-viewer-content]");
			const message = root.querySelector<HTMLElement>("[data-ghb-message]");
			const breadcrumb = root.querySelector<HTMLElement>("[data-ghb-breadcrumb]");
			const backBtn = root.querySelector<HTMLButtonElement>("[data-ghb-back]");
			const forwardBtn = root.querySelector<HTMLButtonElement>("[data-ghb-forward]");
			const refreshBtn = root.querySelector<HTMLButtonElement>("[data-ghb-refresh]");
			const searchEl = root.querySelector<HTMLInputElement>("[data-ghb-search]");
			const actions = root.querySelector<HTMLElement>("[data-ghb-actions]");
			const statusEl = root.querySelector<HTMLElement>("[data-ghb-status]");
			const cloneBtn = root.querySelector<HTMLButtonElement>("[data-ghb-clone]");
			const zipLink = root.querySelector<HTMLAnchorElement>("[data-ghb-zip]");
			const githubLink = root.querySelector<HTMLAnchorElement>("[data-ghb-github]");
			const treeEl = root.querySelector<HTMLElement>("[data-ghb-tree]");
			const treeRows = new Map<string, HTMLElement>();

			const setStatus = (text: string) => { if (statusEl) statusEl.textContent = text; };

			const showGrid = () => {
				if (message) message.hidden = true;
				if (viewer) viewer.hidden = true;
				if (grid) grid.hidden = false;
				if (searchEl) searchEl.value = "";
			};
			const showMessage = (text: string) => {
				if (grid) grid.hidden = true;
				if (viewer) viewer.hidden = true;
				if (message) { message.hidden = false; message.textContent = text; }
			};
			const showViewer = () => {
				if (grid) grid.hidden = true;
				if (message) message.hidden = true;
				if (viewer) viewer.hidden = false;
			};

			const updateNavButtons = () => {
				if (backBtn) {
					const viewingFile = viewer ? !viewer.hidden : false;
					backBtn.disabled = !viewingFile && this.#historyIndex <= 0;
				}
				if (forwardBtn) forwardBtn.disabled = this.#historyIndex >= this.#history.length - 1;
			};

			const pushHistory = (action: () => void | Promise<void>) => {
				this.#history = this.#history.slice(0, this.#historyIndex + 1);
				this.#history.push(action);
				this.#historyIndex = this.#history.length - 1;
				action();
				updateNavButtons();
			};

			const highlightActive = (key: string) => {
				for (const [rowKey, row] of treeRows) row.classList.toggle("is-active", rowKey === key);
			};

			const makeTile = (type: "dir" | "file", name: string, sub: string, onClick: () => void) => {
				const tile = document.createElement("button");
				tile.type = "button";
				tile.className = "ghb__tile";
				const iconSpan = document.createElement("span");
				iconSpan.className = type === "dir" ? "tile-folder-icon" : "tile-file-icon";
				iconSpan.setAttribute("aria-hidden", "true");
				const strong = document.createElement("strong");
				strong.textContent = name;
				const small = document.createElement("small");
				small.textContent = sub;
				tile.append(iconSpan, strong, small);
				tile.addEventListener("click", onClick);
				return tile;
			};

			const addGroupHeading = (text: string, count: number) => {
				if (!grid) return;
				const heading = document.createElement("div");
				heading.className = "ghb__group-heading";
				heading.textContent = `${text} (${count})`;
				grid.append(heading);
			};

			const formatSize = (bytes: number) => {
				if (bytes < 1024) return `${bytes} B`;
				if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
				return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
			};

			const renderBreadcrumb = () => {
				if (!breadcrumb) return;
				breadcrumb.innerHTML = "";
				const segments: { label: string; onClick: (() => void) | null }[] = [
					{ label: "Verkenner", onClick: this.#currentLocation.kind !== "root" ? () => pushHistory(showRoot) : null },
				];
				if (this.#currentLocation.kind === "documents") {
					segments.push({ label: "Mijn documenten", onClick: null });
				} else if (this.#currentLocation.kind === "repo") {
					const { owner, name } = this.#currentLocation;
					const parts = this.#currentPath ? this.#currentPath.split("/") : [];
					segments.push({ label: name, onClick: parts.length ? () => pushHistory(() => gotoRepoPath(owner, name, "")) : null });
					parts.forEach((part, index) => {
						const path = parts.slice(0, index + 1).join("/");
						const isLast = index === parts.length - 1;
						segments.push({ label: part, onClick: isLast ? null : () => pushHistory(() => gotoRepoPath(owner, name, path)) });
					});
				}
				segments.forEach((segment, index) => {
					if (index > 0) breadcrumb.append(document.createTextNode(" › "));
					if (segment.onClick) {
						const button = document.createElement("button");
						button.type = "button";
						button.textContent = segment.label;
						button.addEventListener("click", segment.onClick);
						breadcrumb.append(button);
					} else {
						const strong = document.createElement("strong");
						strong.textContent = segment.label;
						breadcrumb.append(strong);
					}
				});
			};

			const showRoot = () => {
				this.#currentLocation = { kind: "root" };
				this.#currentPath = "";
				if (actions) actions.hidden = true;
				renderBreadcrumb();
				for (const row of treeRows.values()) row.classList.remove("is-active");
				setStatus("Gereed");
				showGrid();
				if (!grid) return;
				grid.innerHTML = "";
				if (this.#documents.length > 0) {
					addGroupHeading("Snelkoppelingen", this.#documents.length);
					grid.append(makeTile("dir", "Mijn documenten", "Locatie", () => pushHistory(openDocuments)));
				}
				if (this.#repos.length > 0) {
					addGroupHeading("Repositories", this.#repos.length);
					for (const repo of this.#repos) grid.append(makeTile("dir", repo.name, "Repository", () => pushHistory(() => gotoRepoPath(repo.owner, repo.name, ""))));
				}
				if (this.#documents.length === 0 && this.#repos.length === 0) showMessage("Nog niets toegevoegd.");
			};

			const openDocuments = () => {
				this.#currentLocation = { kind: "documents" };
				this.#currentPath = "";
				if (actions) actions.hidden = true;
				renderBreadcrumb();
				highlightActive("documents");
				setStatus("Gereed");
				showGrid();
				if (!grid) return;
				grid.innerHTML = "";
				if (this.#documents.length === 0) {
					showMessage("Nog geen documenten toegevoegd. Voeg ze toe in src/data/documents.json.");
					return;
				}
				for (const doc of this.#documents) {
					grid.append(makeTile("file", doc.title, "Document", () => {
						document.dispatchEvent(new CustomEvent("aqua-open-window", { detail: { path: doc.path, title: doc.title } }));
					}));
				}
			};

			const renderEntries = (entries: TreeEntry[]) => {
				showGrid();
				if (!grid || this.#currentLocation.kind !== "repo") return;
				const { owner, name } = this.#currentLocation;
				grid.innerHTML = "";
				const sorted = [...entries].sort((a, b) => {
					if (a.type !== b.type) return a.type === "dir" ? -1 : 1;
					return a.name.localeCompare(b.name);
				});
				for (const entry of sorted) {
					const sub = entry.type === "dir" ? "Map" : formatSize(entry.size);
					grid.append(makeTile(entry.type, entry.name, sub, () =>
						entry.type === "dir" ? pushHistory(() => gotoRepoPath(owner, name, entry.path)) : openFile(entry)
					));
				}
				if (sorted.length === 0) showMessage("Deze map is leeg.");
			};

			const openDir = async (path: string) => {
				if (this.#currentLocation.kind !== "repo") return;
				const { owner, name } = this.#currentLocation;
				this.#currentPath = path;
				renderBreadcrumb();
				highlightActive(`repo::${owner}/${name}::${path}`);
				setStatus("Laden…");
				const data = await this.fetchJson(`https://api.github.com/repos/${owner}/${name}/contents/${path}`);
				if (!data || !Array.isArray(data)) {
					showMessage("Kon deze map niet laden. Probeer het later opnieuw of bekijk de repository direct op GitHub.");
					setStatus("Kon map niet laden");
					return;
				}
				renderEntries(data);
				setStatus("Gereed");
			};

			const openFile = async (entry: TreeEntry) => {
				if (viewerName) viewerName.textContent = entry.name;
				showViewer();
				updateNavButtons();
				if (viewerContent) viewerContent.innerHTML = "";

				if (IMAGE_EXTENSIONS.test(entry.name) && entry.download_url) {
					const img = document.createElement("img");
					img.src = entry.download_url;
					img.alt = entry.name;
					img.className = "ghb__viewer-image";
					viewerContent?.append(img);
					return;
				}
				if (entry.size > MAX_PREVIEW_BYTES) {
					if (viewerContent) viewerContent.textContent = "Dit bestand is te groot om hier te tonen — bekijk het op GitHub.";
					return;
				}
				if (!entry.download_url) {
					if (viewerContent) viewerContent.textContent = "Dit bestand kan niet worden weergegeven.";
					return;
				}
				setStatus("Bestand laden…");
				try {
					const response = await fetch(entry.download_url);
					if (!response.ok) throw new Error(String(response.status));
					if (viewerContent) viewerContent.textContent = await response.text();
					setStatus("Gereed");
				} catch (error) {
					if (import.meta.env.DEV) console.error(error);
					if (viewerContent) viewerContent.textContent = "Kon de inhoud niet ophalen.";
					setStatus("Fout bij laden");
				}
			};

			const openRepo = async (owner: string, name: string) => {
				setStatus("Repository laden…");
				showGrid();
				if (grid) grid.innerHTML = "";
				const meta = await this.fetchJson(`https://api.github.com/repos/${owner}/${name}`);
				const defaultBranch = meta?.default_branch ?? "main";
				const htmlUrl = meta?.html_url ?? `https://github.com/${owner}/${name}`;
				this.#currentLocation = { kind: "repo", owner, name, defaultBranch, htmlUrl };
				if (actions) actions.hidden = false;
				if (zipLink) zipLink.href = `https://github.com/${owner}/${name}/archive/refs/heads/${defaultBranch}.zip`;
				if (githubLink) githubLink.href = htmlUrl;
			};

			const gotoRepoPath = async (owner: string, name: string, path: string) => {
				if (this.#currentLocation.kind !== "repo" || this.#currentLocation.owner !== owner || this.#currentLocation.name !== name) {
					await openRepo(owner, name);
				}
				await openDir(path);
			};

			const fetchRepoDirs = async (owner: string, name: string, path: string): Promise<TreeChildSpec[]> => {
				const data = await this.fetchJson(`https://api.github.com/repos/${owner}/${name}/contents/${path}`);
				if (!Array.isArray(data)) return [];
				return data
					.filter((entry: TreeEntry) => entry.type === "dir")
					.sort((a: TreeEntry, b: TreeEntry) => a.name.localeCompare(b.name))
					.map((dir: TreeEntry) => ({
						key: `repo::${owner}/${name}::${dir.path}`,
						label: dir.name,
						onSelect: () => pushHistory(() => gotoRepoPath(owner, name, dir.path)),
						onExpand: () => fetchRepoDirs(owner, name, dir.path),
					}));
			};

			const createTreeNode = (spec: TreeChildSpec, depth: number): HTMLElement => {
				const wrapper = document.createElement("div");
				wrapper.className = "ghb__tree-node";

				const row = document.createElement("div");
				row.className = "ghb__tree-row";
				row.style.paddingLeft = `${6 + depth * 14}px`;

				const chevron = document.createElement("button");
				chevron.type = "button";
				chevron.className = "ghb__tree-chevron";
				chevron.setAttribute("aria-label", "Map uitklappen");
				if (!spec.onExpand) chevron.classList.add("is-empty");

				const icon = document.createElement("span");
				icon.className = "tile-folder-icon-sm";
				icon.setAttribute("aria-hidden", "true");

				const text = document.createElement("button");
				text.type = "button";
				text.className = "ghb__tree-label";
				text.textContent = spec.label;

				row.append(chevron, icon, text);

				const children = document.createElement("div");
				children.className = "ghb__tree-children";
				children.hidden = true;

				wrapper.append(row, children);
				treeRows.set(spec.key, row);

				let loaded = false;
				const toggle = async () => {
					if (!spec.onExpand) return;
					const opening = children.hidden;
					children.hidden = !opening;
					chevron.classList.toggle("is-open", opening);
					if (!opening || loaded) return;
					loaded = true;
					const childSpecs = await spec.onExpand();
					if (childSpecs.length === 0) { chevron.classList.add("is-empty"); return; }
					for (const child of childSpecs) children.append(createTreeNode(child, depth + 1));
				};
				chevron.addEventListener("click", (event) => { event.stopPropagation(); toggle(); });
				text.addEventListener("click", () => spec.onSelect());

				return wrapper;
			};

			const buildTree = () => {
				if (!treeEl) return;
				treeEl.innerHTML = "";
				treeRows.clear();

				if (this.#documents.length > 0) {
					const heading = document.createElement("div");
					heading.className = "ghb__sidebar-heading";
					heading.textContent = "Snelkoppelingen";
					treeEl.append(heading);
					treeEl.append(createTreeNode({ key: "documents", label: "Mijn documenten", onSelect: () => pushHistory(openDocuments) }, 0));
				}

				if (this.#repos.length > 0) {
					const heading = document.createElement("div");
					heading.className = "ghb__sidebar-heading";
					heading.textContent = "Repositories";
					treeEl.append(heading);
					for (const repo of this.#repos) {
						treeEl.append(createTreeNode({
							key: `repo::${repo.owner}/${repo.name}::`,
							label: repo.name,
							onSelect: () => pushHistory(() => gotoRepoPath(repo.owner, repo.name, "")),
							onExpand: () => fetchRepoDirs(repo.owner, repo.name, ""),
						}, 0));
					}
				}
			};

			cloneBtn?.addEventListener("click", async () => {
				if (this.#currentLocation.kind !== "repo") return;
				const command = `git clone https://github.com/${this.#currentLocation.owner}/${this.#currentLocation.name}.git`;
				try {
					await navigator.clipboard.writeText(command);
					setStatus("Clone-commando gekopieerd naar klembord");
				} catch {
					setStatus(command);
				}
			});

			backBtn?.addEventListener("click", () => {
				if (viewer && !viewer.hidden) {
					this.#history[this.#historyIndex]?.();
					updateNavButtons();
					return;
				}
				if (this.#historyIndex > 0) {
					this.#historyIndex--;
					this.#history[this.#historyIndex]?.();
					updateNavButtons();
				}
			});
			forwardBtn?.addEventListener("click", () => {
				if (this.#historyIndex < this.#history.length - 1) {
					this.#historyIndex++;
					this.#history[this.#historyIndex]?.();
					updateNavButtons();
				}
			});
			refreshBtn?.addEventListener("click", () => {
				this.#cache.clear();
				this.#history[this.#historyIndex]?.();
			});
			searchEl?.addEventListener("input", () => {
				if (!grid) return;
				const query = searchEl.value.trim().toLowerCase();
				for (const tile of grid.querySelectorAll<HTMLElement>(".ghb__tile")) {
					const name = tile.querySelector("strong")?.textContent?.toLowerCase() ?? "";
					tile.hidden = query.length > 0 && !name.includes(query);
				}
			});

			buildTree();
			this.#history = [showRoot];
			this.#historyIndex = 0;
			showRoot();
			updateNavButtons();
		}

		setupWindowControls() {
			const root = this;

			root.querySelector<HTMLButtonElement>("[data-ghb-close]")?.addEventListener("click", () => {
				root.hidden = true;
			});
			root.querySelector<HTMLButtonElement>("[data-ghb-min]")?.addEventListener("click", () => {
				root.classList.add("is-minimized");
				this.#taskButton?.classList.remove("is-active");
			});
			root.querySelector<HTMLButtonElement>("[data-ghb-restore]")?.addEventListener("click", () => {
				root.classList.toggle("is-maximized");
				root.classList.remove("is-minimized");
				this.raiseSelf();
			});
			root.addEventListener("pointerdown", () => this.raiseSelf());

			const ensureTaskButton = () => {
				if (this.#taskButton) return;
				const taskbar = document.querySelector<HTMLElement>("#taskbar-running");
				if (!taskbar) return;
				const button = document.createElement("button");
				button.type = "button";
				button.className = "taskbar-window-button";
				button.innerHTML = `<span aria-hidden="true">▣</span><span>Verkenner</span>`;
				button.title = "Verkenner";
				button.addEventListener("click", () => {
					const isActive = button.classList.contains("is-active");
					if (!root.hidden && !root.classList.contains("is-minimized") && isActive) {
						root.classList.add("is-minimized");
						button.classList.remove("is-active");
						return;
					}
					root.hidden = false;
					root.classList.remove("is-minimized");
					this.raiseSelf();
				});
				taskbar.append(button);
				this.#taskButton = button;
			};

			const observer = new MutationObserver(() => {
				if (root.hidden) {
					this.#taskButton?.remove();
					this.#taskButton = null;
					root.classList.remove("is-minimized", "is-maximized");
				} else {
					ensureTaskButton();
					this.raiseSelf();
				}
			});
			observer.observe(root, { attributes: true, attributeFilter: ["hidden"] });

			if (!root.hidden) ensureTaskButton();
		}

		raiseSelf() {
			this.#zLayer += 1;
			this.style.zIndex = String(this.#zLayer);
			this.#taskButton?.classList.toggle("is-active", !this.hidden && !this.classList.contains("is-minimized"));
		}

		setupDrag() {
			const root = this;
			const handle = root.querySelector<HTMLElement>("[data-ghb-drag-handle]");
			handle?.addEventListener("pointerdown", (event) => {
				if ((event.target as HTMLElement).closest("button")) return;
				const rect = root.getBoundingClientRect();
				const startLeft = rect.left;
				const startTop = rect.top;
				const startX = event.clientX;
				const startY = event.clientY;
				root.style.left = `${startLeft}px`;
				root.style.top = `${startTop}px`;
				handle.setPointerCapture(event.pointerId);
				const move = (moveEvent: PointerEvent) => {
					root.style.left = `${startLeft + moveEvent.clientX - startX}px`;
					root.style.top = `${startTop + moveEvent.clientY - startY}px`;
				};
				handle.addEventListener("pointermove", move);
				handle.addEventListener("pointerup", () => handle.removeEventListener("pointermove", move), { once: true });
			});
		}
	}

	if (!customElements.get("explorer-app")) customElements.define("explorer-app", ExplorerApp);
</script>

